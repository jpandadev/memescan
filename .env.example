# ==============================================
# BlockBurnnn (MemeScan) - Required Environment Variables
# ==============================================
# Add these to your Vercel project:
# https://vercel.com/of8/blockburnnn/settings/environment-variables

# ---------------------------------------------
# API KEYS
# ---------------------------------------------

# API Ninjas - Crypto prices, market data
# Sign up at: https://api-ninjas.com/register (FREE tier: 10k requests/month)
# Note: Default key included in code, but you should use your own
NEXT_PUBLIC_API_NINJAS_KEY=

# ---------------------------------------------
# VERCEL SETUP CHECKLIST:
# ---------------------------------------------
# 1. Go to: https://vercel.com/of8/blockburnnn/settings/environment-variables
# 2. Add NEXT_PUBLIC_API_NINJAS_KEY (Environment: Production, Preview, Development)
# 3. Redeploy: Deployments → ... → Redeploy
