# ==============================================
# BlockBurnnn (MemeScan) - Environment Variables (all optional)
# ==============================================
# Add these to your Vercel project:
# https://vercel.com/of8/blockburnnn/settings/environment-variables

# ---------------------------------------------
# API KEYS
# ---------------------------------------------

# API Ninjas - optional. Only lib/api.ts reads it, server-side, for the
# interest-rate widget (not on any page yet); the site itself is sample data.
# Without it those helpers return empty results. Do not prefix it with
# NEXT_PUBLIC_: that would ship the key to every browser.
# Sign up at: https://api-ninjas.com/register (FREE tier: 10k requests/month)
API_NINJAS_KEY=

# ---------------------------------------------
# VERCEL SETUP CHECKLIST:
# ---------------------------------------------
# 1. Go to: https://vercel.com/of8/blockburnnn/settings/environment-variables
# 2. (Optional) Add API_NINJAS_KEY (Environment: Production, Preview, Development)
# 3. Redeploy: Deployments → ... → Redeploy
